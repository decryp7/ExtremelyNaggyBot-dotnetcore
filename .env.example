# Copy to .env and fill in. Never commit .env.

# Required: token from @BotFather.
TELEGRAM_BOT_TOKEN=123456789:replace-with-your-bot-token

# Optional: public HTTPS address of the Mini App, served by this container on port 8080
# behind your reverse proxy (see Caddyfile.example). Leave empty to disable the Mini App;
# the chat buttons keep working either way.
WEB_APP_URL=https://reminders.example.com

# Optional: address the web server listens on inside the container.
WEB_LISTEN=0.0.0.0:8080

# Optional: chat id that receives an "online" message when the bot starts.
ADMIN_CHATID=

# Optional: Sentry DSN for error reporting. Leave empty to disable.
SENTRY_DSN=

# Optional: log level, e.g. info, debug, or extremely_naggy_bot=debug,info.
RUST_LOG=info
